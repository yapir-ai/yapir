{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@web": ["./src/web"],
      "@web/*": ["./src/web/*"],
      "@server": ["./src/server"],
      "@server/*": ["./src/server/*"],
      "@runner": ["./src/runner"],
      "@runner/*": ["./src/runner/*"],
      "@workflow": ["./src/workflow"],
      "@workflow/schema": ["./src/workflow/schema.ts"],
      "@test/*": ["./tests/*"],
      "@scripts/*": ["./scripts/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./src/web" },
    { "path": "./src/server" },
    { "path": "./src/runner" },
    { "path": "./src/workflow" },
    { "path": "./cli" },
    { "path": "./tests" },
    { "path": "./scripts" },
    { "path": "./tsconfig.node.json" }
  ]
}
