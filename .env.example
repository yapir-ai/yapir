DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/yapir
# 32 random bytes in base64: openssl rand -base64 32
ENCRYPTION_KEY=
# The base URL of the GitLab webhook that Yapir installs. Defaults to SERVER_URL.
# WEBHOOK_URL=
# Development only: the public URL of porthole. Each instance opens on its host, prefixed with its port, and installs its webhooks on this URL.
PORTHOLE_URL=
# Development only: the API base URL of each forge, such as a porthole outbound source. Defaults to the forge.
# GITHUB_API_URL=
# GITLAB_API_URL=
# JIRA_API_URL=
RUNNER_IMAGE=ghcr.io/yapir-ai/runner:latest
# Better Auth's signing and encryption secret. 32 random bytes in base64: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The OIDC application that the local instances sign in with.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Authenticates the migration request of a deployment. Each deployment sets a new one.
MIGRATION_TOKEN=
# Comma-separated emails of the Organization Admins designated by the configuration.
ORGANIZATION_ADMIN_EMAILS=
